# Copy this file to `.env` and fill in your key.
# The app runs WITHOUT a key too — it falls back to deterministic keyword
# matching for the free-text layer — but a key gives you the real LLM engine.

OPENROUTER_API_KEY=

# Any model slug available on OpenRouter. Cheap ones are plenty here.
# Examples: deepseek/deepseek-chat, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=deepseek/deepseek-chat

PORT=3000
